# BasicSearchFlow

main: kit: flow: BasicSearchFlow:
{
  entity: "search",
  kind: "basic",
  name: "BasicSearchFlow",
  step: [
    {
      i: {
        ref: "search_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "search_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSearchFlow"
}