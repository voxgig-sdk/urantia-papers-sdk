# BasicBibleFlow

main: kit: flow: BasicBibleFlow:
{
  entity: "bible",
  kind: "basic",
  name: "BasicBibleFlow",
  step: [
    {
      i: {
        ref: "bible_ref01"
      }

      m: {
        book_code: "book_code01",
        chapter: "chapter01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "bible_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "bible_ref01",
        srcdatavar: "bible_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "bible01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-bible_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicBibleFlow"
}