      h: "Meta"
      n: "meta"
      r: true
      t: "`$OBJECT`"
    }
    notes: {
      h: "Notes"
      n: "notes"
      r: true
      sh: "How the text is numbered or selected"
      t: [
        "`$ONE`"
        [
          "`$STRING`"
          "`$NULL`"
        ]
      ]
    }
    page: {
      h: "Page"
      n: "page"
      r: false
      t: "`$INTEGER`"
    }
    pages: {
      h: "Pages"
      n: "pages"
      r: true
      sh: "The reading pages of the work, in order: one division, or one subdivision for a work with three reference levels."
      t: "`$ARRAY`"
    }
    paragraph: {
      h: "Paragraph"
      n: "paragraph"
      r: true
      t: "`$OBJECT`"
    }
    passage: {
      h: "Passage"
      n: "passage"
      r: true
      t: "`$OBJECT`"
    }
    passageCount: {
      h: "Passage Count"
      n: "passageCount"
      r: true
      t: "`$INTEGER`"
    }
