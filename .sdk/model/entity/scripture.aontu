# Entity: scripture

main: kit: entity: scripture: {

  alias: field: {}

  fields: {
    chunk: {
      h: "Chunk"
      n: "chunk"
      r: true
      t: "`$OBJECT`"
    }
    closest: {
      h: "Closest"
      n: "closest"
      r: true
      t: "`$ARRAY`"
    }
    consensus: {
      h: "Consensus"
      n: "consensus"
      r: true
      sh: "Mean percentile across the texts, 0 to 1"
      t: "`$NUMBER`"
    }
    corpus: {
      h: "Corpus"
      n: "corpus"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "Corpus id, slug, or ref prefix, e.g."
      t: "`$OBJECT`"
    }
    data: {
      h: "Data"
      n: "data"
      r: true
      t: "`$ARRAY`"
    }
    distance: {
      h: "Distance"
      n: "distance"
      r: true
