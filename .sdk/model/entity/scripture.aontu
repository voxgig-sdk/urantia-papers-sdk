      h: "Percentile"
      n: "percentile"
      r: true
      t: "`$NUMBER`"
    }
    q: {
      h: "Q"
      n: "q"
      r: true
      t: "`$STRING`"
    }
    refLevels: {
      h: "Ref Levels"
      n: "refLevels"
      r: true
      sh: "Numbers in a full ref: 1 for `Dhp 183`, 2 for `BG 2.47`, 3 for `Epictetus 3.22.5`"
      t: "`$INTEGER`"
    }
    refPrefix: {
      h: "Ref Prefix"
      n: "refPrefix"
